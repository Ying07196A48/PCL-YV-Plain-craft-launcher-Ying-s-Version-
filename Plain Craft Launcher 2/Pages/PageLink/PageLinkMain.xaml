<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Class="PageLinkMain"
             d:DesignWidth="800" d:DesignHeight="800"
             PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <Grid>
            <!-- 隐藏控件（兼容旧代码） -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="BtnFinishIp" />
                <TextBlock x:Name="LabFinishIp" />
                <TextBlock x:Name="LabFinishPing" />
                <TextBlock x:Name="LabFinishPlayer" />
                <TextBlock x:Name="LabFinishPort" />
                <TextBlock x:Name="BtnFinishPing" />
                <TextBlock x:Name="BtnFinishPort" />
            </StackPanel>

            <!-- 房间标签页（原联机功能） -->
            <Grid x:Name="PanRoom">
                <Grid x:Name="PanLoad">
                    <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="CardLoad" MinWidth="300">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="13" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>
                            <local:MyLoading Grid.Column="1" Grid.Row="1" x:Name="Load" Grid.RowSpan="3" Margin="0,-4,0,-29" HorizontalAlignment="Center"
                                             Text="" TextError="" TextErrorInherit="False" AutoRun="False" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <local:MyLoading.RenderTransform>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                </local:MyLoading.RenderTransform>
                            </local:MyLoading>
                            <TextBlock x:Name="LabLoadTitle" Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="正在创建联机房间" FontSize="19"
                                       Margin="0,0,25,1" Foreground="{Binding Foreground, ElementName=Load}" IsHitTestVisible="False" />
                            <TextBlock x:Name="LabLoadDesc" Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="2" VerticalAlignment="Center" Margin="0,5,10,-5" Text="下载联机模块中……" FontSize="14"
                                       LineHeight="19" MaxWidth="450" MaxHeight="220" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" IsHitTestVisible="False" />
                            <local:MyIconButton Grid.Column="5" Grid.Row="1" x:Name="BtnLoadCancel" Height="25" Width="25"
                                                VerticalAlignment="Top" Margin="0,-13,-13,0"
                                                Theme="Black" Opacity="0.3"
                                                ToolTip="取消" ToolTipService.InitialShowDelay="100"
                                                LogoScale="0.72" Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                            <Grid Height="12" VerticalAlignment="Bottom" Grid.ColumnSpan="100" Grid.RowSpan="100" Margin="0,0,0,-0.6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0*" x:Name="ColumnProgressA" />
                                    <ColumnDefinition Width="1*" x:Name="ColumnProgressB" />
                                </Grid.ColumnDefinitions>
                                <Grid.Clip>
                                    <RectangleGeometry RadiusX="6" RadiusY="6" x:Name="RectProgressClip" />
                                </Grid.Clip>
                                <Rectangle Fill="{Binding Foreground, ElementName=Load}" VerticalAlignment="Bottom" Height="2" />
                            </Grid>
                        </Grid>
                    </local:MyCard>
                </Grid>
                <Grid x:Name="PanContent">
                    <Grid x:Name="PanSelect">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="35" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <local:MyCard x:Name="PanSelectCreate" Grid.Column="1" Grid.Row="1" CornerRadius="13" VerticalAlignment="Center">
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="13" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                </Grid.RowDefinitions>
                                <Path Grid.Column="1" Grid.Row="1" Height="26" Width="26" Margin="0,-1,0,0"
                                    Stretch="Uniform" Fill="{DynamicResource ColorBrush3}"
                                    Data="M384 128v192h256a64 64 0 0 1 64 64v256h192V128H384zM320 320V128a64 64 0 0 1 64-64h512a64 64 0 0 1 64 64v512a64 64 0 0 1-64 64h-192v192a64 64 0 0 1-64 64H128a64 64 0 0 1-64-64V384a64 64 0 0 1 64-64h192z m320 384H384a64 64 0 0 1-64-64V384H128v512h512v-192z m0-64V384H384v256h256z" />
                                <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="1"
                                    Text="创建房间" FontSize="20" Foreground="{DynamicResource ColorBrush3}" />
                                <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="2" Margin="1,10,30,10"
                                    Text="邀请朋友加入你的单人游戏。"
                                    FontSize="15" LineHeight="19" MaxWidth="400" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                            </Grid>
                        </local:MyCard>
                        <local:MyCard x:Name="PanSelectJoin" Grid.Column="1" Grid.Row="3" CornerRadius="13" VerticalAlignment="Center">
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="13" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                </Grid.RowDefinitions>
                                <Path Grid.Column="1" Grid.Row="1" Height="26" Width="26" Margin="0,-1,0,0"
                                    Stretch="Uniform" Fill="{DynamicResource ColorBrush3}"
                                    Data="m399,355l-92.5,101.6c-13.7,13.7-10.6,36.4,4.6,47,13.7,9.1,30.3,7.6,41-4.5l127.4-138.1c16.7-18.2,18.2-47,0-66.8l-125.9-141.1c-12.1-13.7-34.9-15.2-47,0-12.1,12.1-12.1,31.9,0,44l92.5,98.6H28.8c-16.7,0-28.8,13.7-28.8,28.8s13.7,28.8,28.8,28.8h370.2v1.5ZM625.7,0H224.6c-44,0-78.9,34.9-78.9,78.9v101.6c0,15.2,12.1,27.3,27.3,27.3s27.3-12.1,27.3-27.3v-98.6c0-15.2,12.1-27.3,27.3-27.3h387.5c15.2,0,27.3,12.1,27.3,27.3v493c0,15.2-12.1,27.3-27.3,27.3H229.2c-15.2,0-27.3-12.1-27.3-27.3v-101.6c0-16.7-13.7-28.8-28.8-28.8s-28.8,13.7-28.8,28.8v98.6c0,44,34.9,78.9,78.9,78.9h407.2c44,0,67.9-34.9,67.9-78.9V78.9c-4.6-44-28.4-78.9-72.4-78.9Z" />
                                <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="1"
                                    Text="加入房间" FontSize="20" Foreground="{DynamicResource ColorBrush3}" />
                                <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="2" Margin="1,10,30,10"
                                    Text="输入你收到的邀请码，加入朋友的房间。"
                                    FontSize="15" LineHeight="19" MaxWidth="400" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                            </Grid>
                        </local:MyCard>
                        <local:MyCard x:Name="PanLanScan" Grid.Column="1" Grid.Row="5" CornerRadius="12" Margin="0,10,0,0" MinWidth="400">
                            <StackPanel Margin="20,12">
                                <Grid>
                                    <TextBlock Text="局域网游戏" FontSize="15" Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                                    <local:MyButton x:Name="BtnLanScan" Text="扫描" Padding="13,0" Height="28" HorizontalAlignment="Right" ColorType="Highlight" />
                                </Grid>
                                <TextBlock Text="自动发现同一 Wi-Fi 下正在对局域网开放的世界" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" Margin="0,5,0,8" />
                                <StackPanel x:Name="PanLanList" />
                            </StackPanel>
                        </local:MyCard>
                    </Grid>
                    <Grid x:Name="PanFinish" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="35" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="60" />
                        </Grid.RowDefinitions>
                        <local:MyHint Text="你的网络环境差，正使用社区节点进行中继。" HasBorder="True"
                                      HorizontalAlignment="Center" x:Name="HintFinish" Theme="Yellow" />
                        <local:MyCard Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="13" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="25" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="21" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="21" />
                                </Grid.RowDefinitions>
                                <Path Grid.Column="1" Grid.Row="1" Height="28" Width="28" x:Name="ImgFinishLogo"
                                      Stretch="Uniform" Fill="{DynamicResource ColorBrush3}" RenderTransformOrigin="0.5,0.54"
                                      Data="M845 547.45h65.54A400.6 400.6 0 0 0 712.7 201.77l-33.22 56.49C781.6 318.32 845 429.13 845 547.45zM347.72 253.92L316 196.58a401.21 401.21 0 0 0-207 350.87h65.54a335.66 335.66 0 0 1 173.18-293.53zM509.79 882.68a334 334 0 0 1-181.3-53.2L293 884.57a401.13 401.13 0 0 0 419.1 8.91L679 836.93a334.94 334.94 0 0 1-169.21 45.75z M821.51 625.1A108.64 108.64 0 0 0 752.2 650l-67.31-38.86a185.44 185.44 0 0 0 11.22-63.7c0-91.55-66.38-167.9-153.54-183.42V289a109.14 109.14 0 1 0-65.57 0v75c-87.16 15.53-153.54 91.87-153.54 183.42a185.46 185.46 0 0 0 11.22 63.7L267.39 650a109.17 109.17 0 1 0 35.81 55l64.47-37.23a186 186 0 0 0 284.23 0L716.38 705a109.13 109.13 0 1 0 105.13-79.9zM198.07 777.85a43.6 43.6 0 1 1 43.61-43.61 43.66 43.66 0 0 1-43.61 43.61z m311.72-636.53a43.61 43.61 0 1 1-43.61 43.61 43.65 43.65 0 0 1 43.61-43.61z m0 526.91a120.78 120.78 0 1 1 120.78-120.78 120.91 120.91 0 0 1-120.78 120.77z m311.72 109.62a43.6 43.6 0 1 1 43.61-43.61 43.65 43.65 0 0 1-43.61 43.61z" />
                                <TextBlock x:Name="LabFinishTitle" Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,3,0,0"
                                           Text="已加入房间" FontSize="20" Foreground="{DynamicResource ColorBrush3}" />
                                <TextBlock x:Name="LabFinishDesc" Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="2" Margin="1,9,10,10"
                                           Text="描述文本。"
                                           FontSize="14" LineHeight="19" MaxWidth="400" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray2}" />
                                <local:MyButton x:Name="BtnFinishCopy" Grid.Column="4" Grid.Row="3" Margin="0,0,15,0" Text="复制邀请码" Padding="13,8" ColorType="Highlight" />
                                <local:MyButton x:Name="BtnFinishExit" Grid.Column="5" Grid.Row="3" Text="退出" Padding="13,8" />
                            </Grid>
                        </local:MyCard>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 服务器标签页 -->
            <Grid x:Name="PanServer" Visibility="Collapsed">
                <StackPanel x:Name="PanMain" Margin="25,10">
                    <Grid Margin="0,15" x:Name="GridServerHeader">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="服务器" FontSize="20" FontWeight="Light" VerticalAlignment="Center" />
                            <TextBlock Text="浏览公开的 Minecraft 服务器" FontSize="13"
                                       Foreground="{StaticResource ColorBrushGray3}" Margin="15,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <local:MyButton x:Name="BtnServerAdd" Text="添加服务器" MinWidth="80" Padding="13,0" Height="32" ColorType="Highlight" Margin="0,0,10,0" />
                            <local:MyButton x:Name="BtnFavToggle" Text="收藏" MinWidth="80" Padding="13,0" Height="32" />
                        </StackPanel>
                    </Grid>
                    <local:MyCard Margin="0,10,0,15" CornerRadius="12">
                        <StackPanel Margin="20,12">
                            <TextBlock Text="常用服务器" FontSize="15" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,8" />
                            <StackPanel x:Name="PanFavServerList" />
                        </StackPanel>
                    </local:MyCard>
                    <local:MyCard Margin="0,15,0,0" CornerRadius="12">
                        <StackPanel Margin="20,12">
                            <Grid>
                                <TextBlock Text="服务端管理" FontSize="15" Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <local:MyButton x:Name="BtnServerMCPath" Text="选择文件夹" Padding="10,0" Height="28" Margin="0,0,8,0" />
                                    <local:MyButton x:Name="BtnServerMCStart" Text="启动" Padding="10,0" Height="28" ColorType="Highlight" Margin="0,0,8,0" />
                                    <local:MyButton x:Name="BtnServerMCStop" Text="停止" Padding="10,0" Height="28" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LabServerMCPath" Text="未选择服务端文件夹" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" Margin="0,6,0,8" TextTrimming="CharacterEllipsis" />
                            <Border Background="#FF1E1E1E" CornerRadius="6" Padding="8" Height="300">
                                <TextBox x:Name="TxtServerMCLog" IsReadOnly="True" Background="Transparent" Foreground="#FFD4D4D4" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" />
                            </Border>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtServerMCCmd" Height="32" Padding="8,5" Background="{DynamicResource ColorBrush6}" BorderThickness="0" FontFamily="Consolas" FontSize="13"
                                         VerticalContentAlignment="Center" />
                                <local:MyButton Grid.Column="1" x:Name="BtnServerMCSend" Text="发送命令" Padding="12,0" Height="32" Margin="8,0,0,0" ColorType="Highlight" />
                            </Grid>
                            <!-- 常用命令快捷按钮 -->
                            <WrapPanel Margin="0,8,0,0">
                                <local:MyButton x:Name="BtnCmdSay" Text="say" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdTp" Text="tp" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdGive" Text="give" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdOp" Text="op" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdDeop" Text="deop" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdGm0" Text="生存" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdGm1" Text="创造" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdGm3" Text="旁观" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdWhitelist" Text="白名单" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdSave" Text="save-all" Padding="8,0" Height="26" Margin="0,0,6,6" />
                                <local:MyButton x:Name="BtnCmdStop" Text="stop" Padding="8,0" Height="26" Margin="0,0,6,6" />
                            </WrapPanel>
                            <!-- AI 管理 -->
                            <Border Background="{DynamicResource ColorBrush6}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="AI 辅助管理" FontSize="13" Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ChkAIEnabled" Content="启用" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="API 地址" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtAIUrl" Grid.Column="1" Height="26" Padding="6,3" FontSize="12" Background="Transparent" BorderThickness="0"
                                                 Text="https://api.openai.com/v1/chat/completions" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="API Key" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtAIKey" Grid.Column="1" Height="26" Padding="6,3" FontSize="12" Background="Transparent" BorderThickness="0" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模型" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" VerticalAlignment="Center" />
                                        <TextBox x:Name="TxtAIModel" Grid.Column="1" Height="26" Padding="6,3" FontSize="12" Background="Transparent" BorderThickness="0" Text="gpt-4o-mini" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtAINL" Height="30" Padding="6,5" FontSize="12" Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" ToolTip="用自然语言描述你想做什么，AI 会转换成 MC 命令" />
                                        <local:MyButton Grid.Column="1" x:Name="BtnAISend" Text="让 AI 执行" Padding="12,0" Height="30" Margin="8,0,0,0" ColorType="Highlight" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- 定时命令 -->
                            <Border Background="{DynamicResource ColorBrush6}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="定时任务" FontSize="13" Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                                        <local:MyButton x:Name="BtnCronAdd" Text="添加" Padding="10,0" Height="26" HorizontalAlignment="Right" />
                                    </Grid>
                                    <StackPanel x:Name="PanCronList" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </local:MyCard>
                    <StackPanel x:Name="PanServerList" Margin="0,15,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
