<local:MyPageRight x:Class="PageMulti"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,20,20,20">
            <local:MyCard Title="运行中的 MC" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,17">
                    <TextBlock Text="所有正在运行的 MC 进程，可单独关闭，不影响其他挂机" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,15" />
                    <ItemsControl x:Name="ListRunningGames">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource ColorBrushBackground2}" CornerRadius="4" Padding="12,8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" />
                                    </Border>
                                    <local:MyButton Grid.Column="1" Tag="{Binding PID}" Text="关闭进程" Width="100" Height="36" Margin="10,0,0,0" ColorType="Highlight" Click="BtnKillGame_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LabEmpty" Text="当前没有运行中的 MC" Foreground="{DynamicResource ColorBrushGray3}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </ScrollViewer>
</local:MyPageRight>
