<local:MyPageRight x:Class="PageOtherCrawler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!-- 爬虫卡片 -->
            <local:MyCard Margin="0,15" Title="网页文件爬虫" x:Name="CardCrawler">
                <StackPanel Margin="25,40,25,17">
                    <TextBlock Text="输入网址，爬取该页面上的所有文件链接并下载。" FontSize="13" Margin="0,0,0,15" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TxtUrl" Grid.Column="0" Height="32" HintText="https://example.com/files" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnCrawl" Grid.Column="1" Text="开始爬取" Height="32" Padding="20,0" ColorType="Highlight" />
                    </Grid>

                    <TextBlock Text="保存到：" FontSize="13" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TxtSavePath" Grid.Column="0" Height="32" IsReadOnly="True" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnBrowse" Grid.Column="1" Text="浏览..." Height="32" Padding="15,0" />
                    </Grid>

                    <TextBlock x:Name="LabStatus" Text="就绪" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,15" />

                    <TextBlock Text="爬取结果：" FontSize="13" Margin="0,0,0,5" />
                    <ListBox x:Name="LstFiles" Height="200" Background="#22000000" BorderThickness="0" Margin="0,0,0,0" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
